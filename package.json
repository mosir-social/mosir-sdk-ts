{
  "name": "mosir-sdk-ts",
  "version": "0.1.4",
  "description": "TypeScript SDK for the Mosir public GraphQL API",
  "license": "LGPL-3.0-or-later",
  "sideEffects": false,
  "homepage": "https://beta.mosir.app",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/mosir-social/mosir-sdk-ts.git"
  },
  "bugs": {
    "url": "https://github.com/mosir-social/mosir-sdk-ts/issues"
  },
  "keywords": [
    "mosir",
    "graphql",
    "sdk",
    "typescript",
    "sse"
  ],
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=18",
    "bun": ">=1.3.11"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "public.graphqls",
    "public.operations.graphql",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts && node ./scripts/fix-generated-sdk.mjs",
    "build": "pnpm run codegen && tsdown",
    "clean": "rm -rf dist src/generated",
    "typecheck": "tsc --noEmit",
    "test:smoke:sse": "pnpm run build && node --test test/graphql-sse.smoke.test.mjs",
    "check": "pnpm run codegen && pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "graphql": "^16.14.0",
    "graphql-request": "^7.4.0",
    "graphql-sse": "^2.6.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.0.0",
    "@graphql-codegen/typed-document-node": "^7.0.0",
    "@graphql-codegen/typescript": "^6.0.1",
    "@graphql-codegen/typescript-generic-sdk": "^5.0.1",
    "@graphql-codegen/typescript-operations": "^6.0.2",
    "@types/node": "^25.9.1",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  }
}
